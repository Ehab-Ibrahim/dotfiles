    email = e.m.ibrahim@outlook.com
    name = Ehab Ibrahim
    signingkey = key::ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIICue7k+YhwVJinX1QZQH6gtUfX2VJ98Ho/ptS6YMrtG
[commit]
	gpgsign = true
[gpg]
	format = "ssh"
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[pull]
    ff = true
    rebase = true
[core]
    editor = nvim
    # Fall back to less (and plain output) until mise installs delta
    pager = command -v delta >/dev/null && delta || less
[interactive]
    diffFilter = command -v delta >/dev/null && delta --color-only || cat
[delta]
    navigate = true    # use n and N to move between diff sections
[merge]
    conflictstyle = diff3
[diff]
    colorMoved = default
# Machine-specific overrides (e.g. a work email); must stay last so its values win
[include]
    path = ~/.config/git/local
