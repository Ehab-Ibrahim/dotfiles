[user]
    email = {{email}}
    name = {{name}}
    signingkey = {{git_signing_key}}
[commit]
	gpgsign = true
[gpg]
	format = "ssh"
[gpg "ssh"]
	allowedSignersFile = "/home/{{username}}/.config/git/allowed_signers"
[pull]
    ff = true
    rebase = true
[core]
    editor = nvim
    # Fall back to less (and plain output) until mise installs delta
    pager = command -v delta >/dev/null && delta || less
[interactive]
    diffFilter = command -v delta >/dev/null && delta --color-only || cat
[delta]
    navigate = true    # use n and N to move between diff sections
[merge]
    conflictstyle = diff3
[diff]
    colorMoved = default
